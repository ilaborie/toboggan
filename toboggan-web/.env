# Toboggan Web Configuration
#
# Loaded by vite in every mode, so anything here is baked into the production
# bundle that ships inside the `toboggan` binary. Server URLs therefore belong
# in `.env.development` instead — the built client derives them from
# `document.location` so a deck served on any port or host just works.

# WebSocket connection retry configuration
VITE_WS_MAX_RETRIES=5
VITE_WS_INITIAL_RETRY_DELAY=1000
VITE_WS_MAX_RETRY_DELAY=30000
