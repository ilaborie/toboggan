# Dev-server-only configuration, loaded by vite for `pnpm dev` and never for
# `pnpm build`.
#
# During development the app is served by vite on :8000 while the toboggan
# server runs separately on :8080, so the two cannot be derived from the page's
# own location and have to be named explicitly.
#
# They deliberately do NOT live in `.env`, which vite loads in every mode: a
# value there is baked into the production bundle, and that bundle is the one
# embedded in the `toboggan` binary. Pinning :8080 into it meant serving a deck
# on any other port left the WebSocket and every REST call pointing at 8080.
# Without these, the built client derives both from `document.location`.
VITE_WS_BASE_URL=ws://localhost:8080/api/ws
VITE_API_BASE_URL=http://localhost:8080
