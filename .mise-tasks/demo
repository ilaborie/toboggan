#!/usr/bin/env bash
#MISE description="Build and serve the terminal demo presentation"

set -eu

DEMO_DIR="examples/demo-terminal"

# Build the web frontend (embedded by the server)
echo "🌐 Building web frontend..."
mise build:web

# Build the folder in-memory and serve with live reload (unified CLI default action)
echo "🚀 Starting server at http://localhost:8080"
cargo run -p toboggan -- "$DEMO_DIR"
