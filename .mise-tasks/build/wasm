#!/usr/bin/env bash
#MISE description="Build the embedded web client's WASM bundle"

set -eu

export RUST_LOG="info,wasm_pack=warn"
WASM_PROJECT="toboggan-web/toboggan-wasm"

# wasm-opt flags live in the crate's `[package.metadata.wasm-pack.profile.release]`,
# so wasm-pack size-optimizes with its own managed binaryen and this build needs
# no separately-installed wasm-opt (which the release workflow does not have).
wasm-pack build --target web --no-pack --release --out-dir pkg $WASM_PROJECT

# Show file size
echo "Build complete! File sizes:"
ls -lh $WASM_PROJECT/pkg/toboggan_wasm_bg*.wasm
echo "Gzipped size:"
gzip -c $WASM_PROJECT/pkg/toboggan_wasm_bg.wasm | wc -c | awk '{print $1/1024 " KB"}'
