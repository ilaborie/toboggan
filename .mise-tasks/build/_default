#!/usr/bin/env bash
#MISE description="Build all components: Rust, web, WASM, iOS, and Android"

set -eu

echo "🚀 Running comprehensive build for all platforms..."

# Run Rust builds (including WASM)
echo "==================== RUST BUILDS ===================="
mise build:rust

# Run web build
echo "==================== WEB BUILD ======================"
mise build:web

# Run iOS build
echo "==================== iOS BUILD ======================"
mise build:ios

# Run Android build
echo "==================== ANDROID BUILD =================="
mise build:android

# `toboggan` is the only binary in the workspace; every other crate is a library
# it dispatches to, so there is nothing else to install.
cargo install --path toboggan

echo ""
echo "🎉 All platform builds completed successfully!"
echo "✅ Rust: all crates + WASM"
echo "✅ Web: npm build (TypeScript + Vite)"
echo "✅ iOS: Rust targets + Swift bindings"
echo "✅ Android: Rust targets + Kotlin bindings"
echo ""
echo "All builds completed! 🔨"
