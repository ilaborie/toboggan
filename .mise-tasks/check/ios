#!/usr/bin/env bash
#MISE description="Run iOS checks: SwiftLint (the build and tests run in CI)"

set -eu

echo "📱 Running iOS checks..."

mise lint:ios

# The Xcode build and the test suite are the `ios` CI job rather than part of
# `mise check`: they need a simulator runtime matching the iOS 26 deployment
# target, and they take minutes rather than seconds. To run them by hand:
#
#   cargo build -p toboggan-mobile --lib --target aarch64-apple-ios-sim
#   cargo run -p toboggan-mobile --bin uniffi-bindgen -- generate --library \
#     --language swift --out-dir TobogganApp/TobogganApp/ \
#     target/aarch64-apple-ios-sim/debug/libtoboggan.dylib
#   cp target/aarch64-apple-ios-sim/debug/libtoboggan.a TobogganApp/TobogganApp/
#   xcodebuild test -project TobogganApp/TobogganApp.xcodeproj -scheme TobogganApp \
#     -destination 'platform=iOS Simulator,name=iPhone 17 Pro,OS=latest' \
#     -only-testing:TobogganAppTests CODE_SIGNING_ALLOWED=NO

echo "✅ iOS checks passed"
