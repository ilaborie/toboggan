#!/usr/bin/env bash
#MISE description="Run iOS Swift linting with SwiftLint"

set -eu

echo "📱 Linting the Swift with SwiftLint..."

# `--strict`, and no `if …; then … else echo "skipping"`. Both of these used to
# swallow the exit code and print a green summary over a lint that had failed —
# so a violation was green locally and red in CI, which is the one place the
# difference is expensive. SwiftLint is pinned in `.mise.toml`; if it is missing,
# say so and fail rather than quietly checking nothing.
if ! command -v swiftlint >/dev/null 2>&1; then
  echo "error: swiftlint not found. Run 'mise install'." >&2
  exit 1
fi

swiftlint lint --strict --config .swiftlint.yml

echo "✅ Swift lint clean"
