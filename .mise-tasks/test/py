#!/usr/bin/env bash
#MISE description="Build the Python bindings and run their test suite"

set -eu

echo "🐍 Testing the Python bindings..."

# Not a skip. `uv` is declared in `.mise.toml`, so its absence means the toolchain
# was never installed, not that this machine cannot run the tests — and exiting 0
# here made `mise check` print "✅ All Python binding checks passed!" over a suite
# that had not run. A check that cannot fail is not a check.
if ! command -v uv >/dev/null 2>&1; then
  echo "❌ uv not found. Run: mise install"
  exit 1
fi

cd toboggan-py

# This crate is its own workspace, so the root `cargo nextest run` never reaches
# it — the same gap that let two defects ship. The ordering rule the bindings
# run on (`accept`, in src/toboggan.rs) is Rust, and so is its test; without
# this line those tests exist and never run, which is the shape of check this
# repo has been busy removing.
echo "🦀 Running the Rust unit tests..."
cargo test

# The same binary `check:rust` just built. Without it `conftest.py` falls back to
# `cargo run`, which is why its readiness timeout is five minutes.
BUILT_SERVER="$(git rev-parse --show-toplevel)/target/debug/toboggan"
if [ -x "$BUILT_SERVER" ]; then
  export TOBOGGAN_BIN="$BUILT_SERVER"
fi

echo "📦 Installing the dev dependencies..."
uv sync --group dev

# `maturin develop` is what compiles the Rust source that is on disk right now.
# `uv sync` does not: it reuses a cached wheel and will leave a stale extension
# in place after a Rust change. That is also why every command below passes
# `--no-sync` — without it `uv run` re-syncs first and puts the stale wheel
# straight back over the build we just made, so the tests exercise the wrong
# code and pass when they should fail.
echo "🔧 Building the extension..."
uv run --no-sync maturin develop --uv

echo "🧪 Running the tests..."
uv run --no-sync pytest

cd ..

echo "✅ Python binding tests passed!"
