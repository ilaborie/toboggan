#!/usr/bin/env bash
#MISE description="Build + serve the riir-folder example in dev mode (live reload)"

set -eu

# Ensure web frontend is built first (embedded by the server)
echo "🌐 Ensuring web frontend is built..."
mise build:web

echo "🚀 Build + serve examples/riir-folder at http://localhost:8080"
cargo run -p toboggan -- examples/riir-folder
