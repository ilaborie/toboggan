**/xcuserdata/
**/*.xcuserstate
**/*.xcbkptlist
**/*.xcscheme
**/xcshareddata/WorkspaceSettings.xcsettings
**/project.xcworkspace/xcshareddata/
**/project.xcworkspace/xcuserdata/

# Swift Package Manager
.swiftpm/
.build/
**/Package.resolved

# iOS build artifacts
*.ipa
*.dSYM
*.dSYM.zip
DerivedData/
build/
# ...but keep the mise build/* task scripts, which the broad `build/` rule above
# would otherwise hide.
!.mise-tasks/build/
!.mise-tasks/build/**

# Simulator and device logs
simulator_logs/
device_logs/

# Provisioning profiles
*.mobileprovision
*.provisionprofile

# General development temp files
*.swp
*.swo
*~
.tmp
*.tmp
*.bak
*.orig

# IDE files
.vscode/
.idea/
*.sublime-*

# Log files
*.log

# Backup and temporary files with conflict markers
.!*!*

# UniFFI generated files (should be regenerated during build).
# The Swift side is covered by TobogganApp/.gitignore; these are the names that
# land outside it. `TobogganCore.swift` and `libtoboggan_ios_core.a` used to be
# here and matched nothing any build produces.
**/tobogganFFI.h
**/tobogganFFI.modulemap
**/*.xcframework

idea.md
*.local.*
TODO.md
logo/AppIcons.zip

# Playwright MCP browser-session artifacts (page snapshots, console logs).
.playwright-mcp/

# Scratch Typst files the PDF and thumbnail renderers write into a deck's own
# slides folder. Removed after each run, but a killed process leaves one behind.
.toboggan-pdf.typ
.toboggan-thumb.typ
